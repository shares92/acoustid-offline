# .env.example — Bootstrap-Variablen von acoustid-offline (Praefix MMO_)
#
# Verwendung:  cp .env.example .env   und Werte anpassen.
# Die .env selbst wird NIE committet (ARCHITECTURE §8.10 "Secrets nie im Repo").
#
# Hier stehen ausschliesslich BOOTSTRAP-Werte: Pfade, Ports und DB-/Index-
# Zugaenge (ARCHITECTURE §6). Alle Laufzeit-Einstellungen — auth, submit,
# wake, idle, update, cache, ratelimit, metrics, notify, backup, mb.dsn,
# index.query_hashes — leben in der config.yaml auf dem Cache-Volume des
# Waechters und werden ueber die Admin-UI gepflegt, nicht hier.
#
# Seit dem Ein-Container-Umbau (M1b) ist die .env **optional**: alle
# Vorgabewerte beschreiben genau die Aufstellung im Container (Loopback-
# Adressen, die Mounts aus HANDOFF v2 §3). Wer nichts setzt, bekommt einen
# lauffaehigen Container — auch das Datenbank-Passwort erzeugt der
# Entrypoint selbst (DECISIONS 2026-08-04, E16).
#
# Verbindliches Schema seit Phase 3: shared/shared/env.py (`EnvSettings`).
# Diese Datei und das Schema werden zusammen gepflegt — ein Test im
# shared-Paket vergleicht beide Variablensaetze. Phasen 4/5/8 ergaenzen
# Compose-Details.
#
# Leere Werte gelten als "nicht gesetzt" (es greift der Default).
# Unbekannte MMO_-Variablen werden beim Start mit einer Warnung ignoriert.

# --- Waechter (immer an, SSD-Cache-Pool) -----------------------------------

# Port fuer API-Proxy und Admin-UI (/admin). Ein Port fuer beides.
MMO_PORT=8080

# Datenverzeichnis des Waechters: SQLite-Zustand (api_key, admin_user,
# update_run, event_log), Lookup-Cache, Logs, Erststart-Passwort der
# Datenbank. Der Mount /config MUSS auf dem Cache-Pool liegen — NIEMALS
# unter /data: das ist in v2 das Array, und der Waechter schreibt hier im
# laufenden Betrieb (die Platten schliefen nie).
MMO_DATA_DIR=/config

# Pfad der Laufzeit-Konfiguration; wird beim ersten Start mit den Defaults
# aus ARCHITECTURE §6 angelegt. Default: <MMO_DATA_DIR>/config.yaml.
MMO_CONFIG_PATH=/config/config.yaml

# --- API-Dienst (Ziel des Waechter-Proxys) ---------------------------------

# Basis-URL des API-Dienstes: dorthin leitet der Waechter /v2/* weiter.
# Containerintern auf dem Loopback — der Dienst hat keinen veroeffentlichten
# Port, davor sitzt der Waechter mit Auth und Rate-Limit.
MMO_API_BASE_URL=http://127.0.0.1:8081

# Interner Healthcheck des API-Dienstes — die Bereitschaftsfrage des
# Weckvorgangs (prueft Datenbank UND Index, DECISIONS 2026-08-01). Ohne
# eigenen Wert folgt er MMO_API_BASE_URL mit dem Zusatz /_health.
MMO_API_HEALTH_URL=http://127.0.0.1:8081/_health

# Port, auf dem der API-Dienst lauscht (Bind: 127.0.0.1). Bindend, seit
# Waechter und API sich einen Netzwerk-Namensraum teilen — MMO_PORT (8080)
# gehoert dem Waechter.
MMO_API_PORT=8081

# --- Logging ---------------------------------------------------------------

# Level des strukturierten JSON-Logs auf stderr (shared.setup_logging).
# Bootstrap-Wert, weil das Log steht, bevor die config.yaml gelesen ist;
# erlaubt: CRITICAL, ERROR, WARNING, INFO, DEBUG, NOTSET.
MMO_LOG_LEVEL=INFO

# --- AcoustID-Postgres (eingebacken; Daten auf dem Array) ------------------

# Containerintern; die Datenbank lauscht nur auf dem Loopback.
MMO_DB_HOST=127.0.0.1
MMO_DB_PORT=5432
MMO_DB_NAME=acoustid
MMO_DB_USER=acoustid
# LEER LASSEN: der Entrypoint erzeugt das Passwort beim ersten Start und
# legt es in MMO_DB_PASSWORD_FILE ab (DECISIONS 2026-08-04, E16). Ein hier
# gesetzter Wert gewinnt — dann muss er zur Rolle im Cluster passen (so
# wird ein v1-Bestand uebernommen, docs/migration-v1-v2.md §7).
MMO_DB_PASSWORD=

# Datei mit dem Passwort; gilt, wenn MMO_DB_PASSWORD leer ist. Default:
# <MMO_DATA_DIR>/db-password (0600). Sie ist die gemeinsame Quelle fuer
# ALLE Prozesse — auch fuer die, die per `docker compose exec` dazukommen
# und die Umgebung des Entrypoints nicht erben (Importer-Laeufe!).
MMO_DB_PASSWORD_FILE=/config/db-password

# Wurzel der Postgres-Datenverzeichnisse; darunter liegt je Major-Version
# ein Verzeichnis (/data/db/18). Array-Mount. Der Waechter prueft hier den
# Versions-Drift und verweigert den Start auf fremdem Bestand (E14).
MMO_DB_DATA_ROOT=/data/db

# Major-Version, die DIESES Image mitbringt. Keine Betreiber-Einstellung:
# der Wert wird im Dockerfile gesetzt und beschreibt das Artefakt.
MMO_PG_MAJOR=18

# --- Suchindex (acoustid-index, SSD-Cache-Pool) ----------------------------

# Nur containerintern erreichbar: der Index hat keine Auth und kein TLS,
# Port 6081 daher niemals veroeffentlichen (ARCHITECTURE §3, §5.3).
MMO_INDEX_URL=http://127.0.0.1:6081

# Name des Suchindex im acoustid-index (ein Server kann mehrere halten; wir
# fahren genau einen). Erlaubt sind Buchstaben, Ziffern, "_" und "-"; das
# erste Zeichen muss ein Buchstabe oder eine Ziffer sein. Der Container-
# Healthcheck prueft /<name>/_health, deshalb steht der Wert hier und nicht
# in der config.yaml. Aendern heisst: leerer Index, also Neuaufbau.
MMO_INDEX_NAME=main

# --- Importer (One-Shot-Job) -----------------------------------------------

# Arbeitsverzeichnis fuer heruntergeladene Delta-Dateien (Prefetch/Resume).
# Eigener Mount auf dem Array (v2 §3): die Tagesdateien sind mehrere GB
# gross und haben auf dem Cache-Pool nichts zu suchen. Folgt deshalb
# bewusst NICHT MMO_DATA_DIR.
MMO_DUMP_DIR=/import

# Hinweis: Der Zugang zur MusicBrainz-Postgres ist bewusst KEINE Env-Variable,
# sondern die Laufzeit-Einstellung `mb.dsn` in der config.yaml (ARCHITECTURE §6).

# --- Container-Werte ohne MMO_-Praefix ------------------------------------
#
# Sie gehoeren nicht ins Schema der Anwendung (shared/shared/env.py) und
# wuerden dort als „unbekannt" gemeldet — sie steuern nur den Container:
#
#   ACOUSTID_INDEX_DIR    Datenverzeichnis des Suchindex (Default /index,
#                         gehoert auf den SSD-Cache — DECISIONS 2026-07-25)
#   ACOUSTID_INDEX_PORT   Port des Suchindex (Default 6081)
#   ACOUSTID_BIND_ADDRESS Adresse von Postgres und Index (Default 127.0.0.1;
#                         nur die Test-Zusammenstellung setzt 0.0.0.0)
#   ACOUSTID_BACKUP_DIR   Ziel des Backup-Jobs ab M2.5 (Default /backup)
