# .env.example — Bootstrap-Variablen von acoustid-offline (Praefix AOFF_)
#
# Verwendung:  cp .env.example .env   und Werte anpassen.
# Die .env selbst wird NIE committet (ARCHITECTURE §8.10 "Secrets nie im Repo").
#
# Hier stehen ausschliesslich BOOTSTRAP-Werte: Pfade, Ports und DB-/Index-
# Zugaenge (ARCHITECTURE §6). Alle Laufzeit-Einstellungen — auth, submit,
# wake, idle, update, cache, ratelimit, metrics, notify, backup, mb.dsn,
# index.query_hashes — leben in der config.yaml auf dem Cache-Volume des
# Waechters und werden ueber die Admin-UI gepflegt, nicht hier.
#
# Der Satz waechst in spaeteren Phasen (Phase 3 legt das Env-Schema im
# shared-Paket verbindlich fest, Phasen 4/5/8 ergaenzen Compose-Details).

# --- Waechter (immer an, SSD-Cache-Pool) -----------------------------------

# Port fuer API-Proxy und Admin-UI (/admin). Ein Port fuer beides.
AOFF_PORT=8080

# Datenverzeichnis des Waechters: SQLite-Zustand (api_key, admin_user,
# update_run, event_log), Lookup-Cache, Logs. Muss auf dem Cache-Pool liegen.
AOFF_DATA_DIR=/data

# Pfad der Laufzeit-Konfiguration; wird beim ersten Start mit den Defaults
# aus ARCHITECTURE §6 angelegt.
AOFF_CONFIG_PATH=/data/config.yaml

# --- AcoustID-Postgres (Stack, Array) --------------------------------------

# Hostname im Compose-Netz (Container-Name laut ARCHITECTURE §6).
AOFF_DB_HOST=acoustid-db
AOFF_DB_PORT=5432
AOFF_DB_NAME=acoustid
AOFF_DB_USER=acoustid
# Pflichtwert — vor dem ersten Start setzen, kein Default.
AOFF_DB_PASSWORD=

# --- Suchindex (acoustid-index, SSD-Cache-Pool) ----------------------------

# Nur Compose-intern erreichbar: der Index hat keine Auth und kein TLS,
# Port 6081 daher niemals veroeffentlichen (ARCHITECTURE §3, §5.3).
AOFF_INDEX_URL=http://acoustid-index:6081

# --- Importer (One-Shot-Job) -----------------------------------------------

# Arbeitsverzeichnis fuer heruntergeladene Delta-Dateien (Prefetch/Resume).
AOFF_DUMP_DIR=/data/dumps

# Hinweis: Der Zugang zur MusicBrainz-Postgres ist bewusst KEINE Env-Variable,
# sondern die Laufzeit-Einstellung `mb.dsn` in der config.yaml (ARCHITECTURE §6).
