{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git merge --ff-only:*)",
      "Bash(gh run:*)",
      "Bash(docker compose config:*)",
      "Bash(docker compose ps:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre_guard.py\"",
            "timeout": 15,
            "statusMessage": "Sperrzonen pruefen (Migrations-Drift, Fixtures, pg_acoustid)"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/post_doc_tests.py\"",
            "timeout": 300,
            "statusMessage": "Doku-gekoppelte Tests (ARCHITECTURE §5.1/§5.2/§6/§10)"
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/post_ruff.py\"",
            "timeout": 200,
            "statusMessage": "ruff format + check --fix"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/session_start.py\"",
            "timeout": 30,
            "statusMessage": "Vorpruefung: git log, Statuskopf, Worktrees, Docker"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop_report.py\"",
            "timeout": 30,
            "statusMessage": "Doku-Sweep, Worktrees und unpushed Commits pruefen"
          }
        ]
      }
    ]
  }
}
